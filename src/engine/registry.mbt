struct FnSpec {
  min : Int
  max : Int
  call : (Ctx, Array[Thunk]) -> Value
}

fn lookup_fn(name : String) -> FnSpec? {
  match name {
    "IF" => Some({ min: 2, max: 3, call: fn_if })
    "IFS" => Some({ min: 2, max: 254, call: fn_ifs })
    "SWITCH" => Some({ min: 3, max: 254, call: fn_switch })
    "AND" => Some({ min: 1, max: 30, call: fn_and })
    "OR" => Some({ min: 1, max: 30, call: fn_or })
    "NOT" => Some({ min: 1, max: 1, call: fn_not })
    "IFERROR" => Some({ min: 2, max: 2, call: fn_iferror })
    "ROUND" => Some({ min: 2, max: 2, call: fn_round })
    "ROUNDUP" => Some({ min: 2, max: 2, call: fn_roundup })
    "ROUNDDOWN" => Some({ min: 2, max: 2, call: fn_rounddown })
    "ABS" => Some({ min: 1, max: 1, call: fn_abs })
    "INT" => Some({ min: 1, max: 1, call: fn_int })
    "MOD" => Some({ min: 2, max: 2, call: fn_mod })
    "POWER" => Some({ min: 2, max: 2, call: fn_power })
    "SQRT" => Some({ min: 1, max: 1, call: fn_sqrt })
    "SUM" => Some({ min: 1, max: 30, call: fn_sum })
    "SUMIF" => Some({ min: 2, max: 3, call: fn_sumif })
    "SUMPRODUCT" => Some({ min: 1, max: 30, call: fn_sumproduct })
    "AVERAGE" => Some({ min: 1, max: 30, call: fn_average })
    "COUNT" => Some({ min: 1, max: 30, call: fn_count })
    "COUNTA" => Some({ min: 1, max: 30, call: fn_counta })
    "COUNTIF" => Some({ min: 2, max: 2, call: fn_countif })
    "MIN" => Some({ min: 1, max: 30, call: fn_min })
    "MAX" => Some({ min: 1, max: 30, call: fn_max })
    "MEDIAN" => Some({ min: 1, max: 30, call: fn_median })
    "LEFT" => Some({ min: 1, max: 2, call: fn_left })
    "RIGHT" => Some({ min: 1, max: 2, call: fn_right })
    "MID" => Some({ min: 3, max: 3, call: fn_mid })
    "LEN" => Some({ min: 1, max: 1, call: fn_len })
    "TRIM" => Some({ min: 1, max: 1, call: fn_trim })
    "UPPER" => Some({ min: 1, max: 1, call: fn_upper })
    "LOWER" => Some({ min: 1, max: 1, call: fn_lower })
    "CONCAT" => Some({ min: 1, max: 30, call: fn_concat })
    "TEXTJOIN" => Some({ min: 3, max: 254, call: fn_textjoin })
    "TEXT" => Some({ min: 2, max: 2, call: fn_text })
    "VALUE" => Some({ min: 1, max: 1, call: fn_value })
    "FIND" => Some({ min: 2, max: 3, call: fn_find })
    "SUBSTITUTE" => Some({ min: 3, max: 4, call: fn_substitute })
    "VLOOKUP" => Some({ min: 3, max: 4, call: fn_vlookup })
    "XLOOKUP" => Some({ min: 3, max: 6, call: fn_xlookup })
    "HLOOKUP" => Some({ min: 3, max: 4, call: fn_hlookup })
    "INDEX" => Some({ min: 2, max: 3, call: fn_index })
    "MATCH" => Some({ min: 2, max: 3, call: fn_match })
    "DATE" => Some({ min: 3, max: 3, call: fn_date })
    "EOMONTH" => Some({ min: 2, max: 2, call: fn_eomonth })
    "YEAR" => Some({ min: 1, max: 1, call: fn_year })
    "MONTH" => Some({ min: 1, max: 1, call: fn_month })
    "DAY" => Some({ min: 1, max: 1, call: fn_day })
    "TODAY" => Some({ min: 0, max: 0, call: fn_today })
    "NOW" => Some({ min: 0, max: 0, call: fn_now })
    "STDEV" => Some({ min: 1, max: 30, call: fn_stdev })
    "VAR" => Some({ min: 1, max: 30, call: fn_var })
    "PERCENTILE" => Some({ min: 2, max: 2, call: fn_percentile })
    "REPLACE" => Some({ min: 4, max: 4, call: fn_replace })
    "SEARCH" => Some({ min: 2, max: 3, call: fn_search })
    "PROPER" => Some({ min: 1, max: 1, call: fn_proper })
    "CEILING" => Some({ min: 2, max: 2, call: fn_ceiling })
    "FLOOR" => Some({ min: 2, max: 2, call: fn_floor })
    "CHOOSE" => Some({ min: 2, max: 254, call: fn_choose })
    "XOR" => Some({ min: 1, max: 254, call: fn_xor })
    _ => None
  }
}