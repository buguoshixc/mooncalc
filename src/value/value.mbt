/// Excel UPPER：逐字符 Unicode 简单大写映射（不做展开，如 `UPPER("straße")` = `"STRAßE"`）。
pub fn unicode_upper(s : String) -> String {
  let mut out = ""
  for c in s.iter() {
    out = out + unicode_upper_char(c).to_string()
  }
  out
}

fn unicode_upper_char(c : Char) -> Char {
  let v = c.to_int()
  let mut lo = 0
  let mut hi = upper_ranges.length() - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let (a, b, d) = upper_ranges[mid]
    if v < a.to_int() {
      hi = mid - 1
    } else if v > b.to_int() {
      lo = mid + 1
    } else {
      return (v + d).unsafe_to_char()
    }
  }
  c
}

/// Excel 录入精度：数字最多 15 位有效十进制数字，超出部分直接置零（不四舍五入），
/// 如 `123456789012345678` → `123456789012345000`。非有限值与 0 原样返回。
pub fn excel_precision(d : Double) -> Double {
  if d == 0.0 || !d.is_finite() {
    return d
  }
  let text = d.to_string()
  let chars = Array::from_iter(text.iter())
  let n = chars.length()
  let mut i = 0
  let mut neg = false
  if i < n && chars[i] == '-' {
    neg = true
    i += 1
  }
  let digits : Array[Char] = []
  let mut dot = -1
  while i < n && chars[i] != 'e' && chars[i] != 'E' {
    if chars[i] == '.' {
      dot = digits.length()
    } else {
      digits.push(chars[i])
    }
    i += 1
  }
  let mut ep = 0
  if i < n {
    i += 1
    let mut esign = 1
    if i < n && chars[i] == '+' {
      i += 1
    } else if i < n && chars[i] == '-' {
      esign = -1
      i += 1
    }
    while i < n {
      ep = ep * 10 + (chars[i].to_int() - 48)
      i += 1
    }
    ep *= esign
  }
  if dot < 0 {
    dot = digits.length()
  }
  let m = digits.length()
  let mut lead = 0
  while lead < m - 1 && digits[lead] == '0' {
    lead += 1
  }
  let sig_len = m - lead
  if sig_len <= 15 {
    return d
  }
  // decimal exponent of the leading significant digit
  let exp = dot - lead - 1 + ep
  let mut body = ""
  for k in 0..<15 {
    body = body + digits[lead + k].to_string()
  }
  let mut repr = if neg { "-" } else { "" }
  repr = repr + body.substring(start=0, end=1)
  repr = repr + "." + body.substring(start=1, end=15)
  repr = repr + "e" + exp.to_string()
  @string.parse_double(repr[:]) catch { _ => d }
}
